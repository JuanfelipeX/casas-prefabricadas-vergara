---
import '../styles/global.css';

const photos = [
  {
    image: 'https://images.homify.com/images/a_0%2Cc_fit%2Cf_auto%2Cq_auto%2Cw_1108/v1577039330/p/photo/image/3299736/c72/fotos-de-casas-prefabricadas-de-estilo-moderno-de-prefabricados-palermo.jpg',
    alt: 'Casa prefabricada colombiana de una planta con fachada clara y jardín sencillo',
    kicker: 'CASAS PREFABRICADAS · COLOMBIA',
    title: 'Tu casa.<br><em>Tu forma de vivir.</em>',
    text: 'Viviendas funcionales que se ven bien, se sienten tuyas y parten de lo que necesitas para tu terreno.',
    note: 'FACHADA · LUZ · ESPACIO'
  },
  {
    image: 'https://imagenes2.eltiempo.com/files/og_thumbnail/uploads/2020/08/29/5f4b288cd7fd2.jpeg',
    alt: 'Casa prefabricada amarilla de un piso, techo rojo y pequeño corredor en un entorno rural colombiano',
    kicker: 'SENCILLA, CUIDADA Y FUNCIONAL',
    title: 'Lo esencial,<br><em>con más carácter.</em>',
    text: 'Una buena combinación de color, una entrada agradable y detalles bien presentados hacen la diferencia.',
    note: 'COLOR · CUBIERTA · ENTRADA'
  },
  {
    image: 'https://www.minvivienda.gov.co/sites/default/files/noticias/270921_img1.jpg',
    alt: 'Vivienda prefabricada de paneles verdes y cubierta metálica en un terreno abierto',
    kicker: 'IDEAS PARA TU PROYECTO',
    title: 'Un espacio propio.<br><em>Muchas posibilidades.</em>',
    text: 'Miremos opciones de vivienda sin perder de vista el terreno, el presupuesto y lo que incluye cada propuesta.',
    note: 'PANELES · TERRENO · PROYECTO'
  }
];

const models = [
  {
    id: 'compacta', no: '01', title: 'La compacta', tag: 'SENCILLA Y FUNCIONAL',
    image: 'https://imagenes2.eltiempo.com/files/og_thumbnail/uploads/2020/08/29/5f4b288cd7fd2.jpeg',
    alt: 'Casa prefabricada amarilla con cubierta roja y un pequeño corredor',
    body: 'Una idea para priorizar los espacios esenciales y una distribución práctica.'
  },
  {
    id: 'familiar', no: '02', title: 'La familiar', tag: 'ESPACIO PARA COMPARTIR',
    image: 'https://www.sucasaprefabricada.com/wp-content/uploads/2016/01/88m.jpg',
    alt: 'Casa prefabricada blanca con cubierta roja y corredor al frente',
    body: 'Una referencia para pensar en áreas comunes y espacios privados según tu familia.'
  },
  {
    id: 'corredor', no: '03', title: 'Con corredor', tag: 'UNA ENTRADA ACOGEDORA',
    image: 'https://www.minvivienda.gov.co/sites/default/files/noticias/270921_img1.jpg',
    alt: 'Casa prefabricada de paneles verdes con ventanas blancas y cubierta metálica',
    body: 'Un espacio de entrada cubierto puede ser útil; confirma con el proveedor si está incluido.'
  }
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Explora ideas de casas prefabricadas para tu terreno en Vergara, Cundinamarca, y prepara tu consulta por WhatsApp." />
  <meta name="theme-color" content="#17251f" />
  <title>Vergara | Casas prefabricadas</title>
</head>
<body>
  <div class="scroll-progress" aria-hidden="true"><span id="scrollProgress"></span></div>
  <header class="topbar">
    <a class="brand" href="#inicio" aria-label="Vergara Casas Prefabricadas, inicio">
      <span class="brand-icon" aria-hidden="true"><svg viewBox="0 0 36 36"><path d="M4 17.5 18 5l14 12.5V32H22V21h-8v11H4Z"/><path d="M25 9.5V4h4v9"/></svg></span>
      <span class="brand-words"><b>VERGARA</b><small>CASAS PREFABRICADAS</small></span>
    </a>
    <nav class="main-nav" aria-label="Navegación principal">
      <a href="#modelos">Diseños</a><a href="#tu-idea">Tu proyecto</a><a href="#contacto">Contacto</a>
    </nav>
    <a class="nav-cta" href="#tu-idea">Cuéntanos tu idea <span>↗</span></a>
    <button class="menu-toggle" id="menuToggle" type="button" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span></button>
    <div class="menu-panel" id="menuPanel" hidden>
      <a href="#modelos">Ver diseños <span>↗</span></a><a href="#tu-idea">Armar mi idea <span>↗</span></a><a href="#contacto">Contacto <span>↗</span></a>
    </div>
  </header>

  <main>
    <!-- SECCIÓN 1: BIENVENIDA -->
    <section class="hero" id="inicio" aria-label="Bienvenida">
      <img class="hero-photo" id="heroPhoto" src={photos[0].image} alt={photos[0].alt} fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span></span><b id="heroKicker">{photos[0].kicker}</b></p>
        <h1 id="heroTitle" set:html={photos[0].title}></h1>
        <p class="hero-lead" id="heroText">{photos[0].text}</p>
        <div class="hero-actions">
          <a class="button button-cream" href="#modelos">Explorar diseños <span>↘</span></a>
          <a class="quiet-link" href="#tu-idea">Imagina tu proyecto <span>↗</span></a>
        </div>
      </div>
      <div class="hero-stamp"><span class="stamp-dot"></span><b>IDEAS PARA VIVIENDA REAL</b><small>Vergara · Cundinamarca</small></div>
      <div class="hero-bottom">
        <div class="hero-caption"><span id="heroNote">{photos[0].note}</span><i></i><span>IMÁGENES DE REFERENCIA</span></div>
        <div class="slide-controls">
          {photos.map((photo, i) => <button type="button" class:list={['slide-dot', i === 0 ? 'active' : '']} data-slide={i} aria-label={'Ver imagen ' + (i + 1)} aria-pressed={i === 0 ? 'true' : 'false'}><span>{String(i + 1).padStart(2, '0')}</span><i></i></button>)}
          <button type="button" class="slide-arrow" id="previousSlide" aria-label="Imagen anterior">←</button>
          <button type="button" class="slide-arrow" id="nextSlide" aria-label="Imagen siguiente">→</button>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: MODELOS Y FOTOGRAFÍAS -->
    <section class="models-section section" id="modelos">
      <div class="section-heading">
        <div><p class="eyebrow dark"><span></span> DISEÑOS PARA EXPLORAR</p><h2>Casas sencillas.<br><em>Ideas bien presentadas.</em></h2></div>
        <p>Encuentra una referencia que se acerque a lo que imaginas. La fachada, los materiales, las medidas y lo incluido deben confirmarse con el proveedor.</p>
      </div>
      <div class="model-showcase">
        <div class="model-list" role="tablist" aria-label="Selecciona una idea de vivienda">
          {models.map((model, i) => <button type="button" class:list={['model-tab', i === 0 ? 'active' : '']} data-model={model.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls="modelDetail"><span class="tab-number">{model.no}</span><span class="tab-copy"><small>{model.tag}</small><b>{model.title}</b></span><span class="tab-arrow">↗</span></button>)}
          <p class="model-disclaimer">Fotografías de referencia de viviendas prefabricadas en Colombia. No son un catálogo confirmado del proveedor de Vergara.</p>
          <a href="#tu-idea" class="model-next">Cuéntanos qué buscas <span>↘</span></a>
        </div>
        <div class="model-visual" id="modelVisual">
          {models.map((model, i) => <img class="model-image" data-image-model={model.id} src={model.image} alt={model.alt} loading="lazy" class:list={[i === 0 ? 'visible' : '']} />)}
          <div class="model-image-shade"></div>
          <div class="image-counter"><span id="modelCounter">01</span><i></i><span>03</span></div>
          <button class="image-expand" id="openModelImage" type="button" aria-label="Ver fotografía más grande">⤢</button>
          <div class="model-detail" id="modelDetail" role="tabpanel">
            <p class="detail-kicker" id="detailTag">{models[0].tag}</p>
            <h3 id="detailTitle">{models[0].title}</h3>
            <p id="detailBody">{models[0].body}</p>
          </div>
        </div>
      </div>
      <div class="models-footer"><span>01 — 03</span><span>FUNCIONALIDAD · ESTILO · TERRENO</span></div>
    </section>

    <!-- SECCIÓN 3: FORMULARIO / CONFIGURADOR -->
    <section class="configurator section" id="tu-idea">
      <div class="config-heading">
        <div><p class="eyebrow dark"><span></span> TU PROYECTO COMIENZA AQUÍ</p><h2>Cuéntanos qué<br><em>estás imaginando.</em></h2></div>
        <p>Selecciona las opciones que mejor describen tu idea. Prepararemos un resumen para que lo envíes directamente por WhatsApp.</p>
      </div>
      <div class="config-body">
        <div class="config-steps">
          <fieldset class="config-group" data-choice-group="vivienda">
            <legend><span>01</span><b>¿Qué tipo de casa tienes en mente?</b></legend>
            <div class="choice-chips"><button type="button" class="choice-chip selected" data-value="Una casa compacta">Compacta</button><button type="button" class="choice-chip" data-value="Una casa para mi familia">Familiar</button><button type="button" class="choice-chip" data-value="Una casa con corredor">Con corredor</button></div>
          </fieldset>
          <fieldset class="config-group" data-choice-group="terreno">
            <legend><span>02</span><b>¿Cómo está tu terreno?</b></legend>
            <div class="choice-chips"><button type="button" class="choice-chip selected" data-value="Lote destapado o de tierra">Destapado / tierra</button><button type="button" class="choice-chip" data-value="Lote con acceso preparado">Acceso preparado</button><button type="button" class="choice-chip" data-value="Terreno por revisar">Por revisar</button></div>
          </fieldset>
          <fieldset class="config-group" data-choice-group="prioridad">
            <legend><span>03</span><b>¿Qué te gustaría priorizar?</b></legend>
            <div class="choice-chips"><button type="button" class="choice-chip selected" data-value="Distribución funcional">Funcionalidad</button><button type="button" class="choice-chip" data-value="Un espacio exterior agradable">Espacio exterior</button><button type="button" class="choice-chip" data-value="Construir por etapas">Construir por etapas</button></div>
          </fieldset>
        </div>
        <aside class="config-summary">
          <div class="summary-head"><span>RESUMEN DE TU IDEA</span><span class="live-dot"></span></div>
          <h3>Vamos paso a paso.</h3>
          <div class="summary-row"><span>TIPO DE CASA</span><b id="summaryVivienda">Una casa compacta</b></div>
          <div class="summary-row"><span>TERRENO</span><b id="summaryTerreno">Lote destapado o de tierra</b></div>
          <div class="summary-row"><span>PRIORIDAD</span><b id="summaryPrioridad">Distribución funcional</b></div>
          <p class="summary-note">Este resumen es una consulta inicial; no confirma precio, disponibilidad ni trabajos incluidos.</p>
          <div class="summary-message"><span class="summary-check" aria-hidden="true">✓</span><p><strong>Tu idea está lista.</strong><br>Estas preferencias se incluirán en el mensaje de WhatsApp del final.</p></div><a class="summary-next" href="#contacto">Continuar al contacto <span>↓</span></a>
        </aside>
      </div>
    </section>

    <!-- SECCIÓN 4: CIERRE Y CONTACTO -->
    <section class="contact section" id="contacto">
      <div class="contact-copy">
        <p class="eyebrow"><span></span> EL SIGUIENTE PASO ES CONVERSAR</p>
        <h2>Tu casa no empieza<br>con un plano.<br><em>Empieza con una idea.</em></h2>
        <p>Cuéntanos qué quieres construir en Vergara y qué condiciones tiene tu lote. Con el resumen que preparaste, puedes escribirnos y comenzar la conversación.</p>
      </div>
      <div class="contact-panel">
        <span class="contact-index">VERGARA · CASAS PREFABRICADAS</span>
        <h3>Hagamos que tu idea tome forma.</h3>
        <p>Envía tus preferencias por WhatsApp y consulta qué opciones existen para tu terreno.</p>
        <a class="button button-cream" id="whatsAppFinal" href="https://wa.me/573134843085" target="_blank" rel="noopener noreferrer">Hablar por WhatsApp <span>↗</span></a>
        <div class="contact-divider"></div>
        <span class="contact-footnote">Las fotos son referencias visuales. Los modelos, materiales y especificaciones deben confirmarse con el proveedor.</span>
      </div>
    </section>
  </main>

  <footer class="footer">
    <a class="brand" href="#inicio"><span class="brand-icon"><svg viewBox="0 0 36 36"><path d="M4 17.5 18 5l14 12.5V32H22V21h-8v11H4Z"/><path d="M25 9.5V4h4v9"/></svg></span><span class="brand-words"><b>VERGARA</b><small>CASAS PREFABRICADAS</small></span></a>
    <span>Diseño con los pies en la tierra.</span><small>© {new Date().getFullYear()} · Sitio demostrativo</small>
  </footer>

  <dialog id="photoDialog" class="photo-dialog"><button type="button" id="closePhotoDialog" class="dialog-close" aria-label="Cerrar fotografía">×</button><img id="dialogPhoto" src={models[0].image} alt={models[0].alt}><p id="dialogCaption">{models[0].title} · Foto de referencia</p></dialog>

  <script>
    const slides = [
      { image: 'https://images.homify.com/images/a_0%2Cc_fit%2Cf_auto%2Cq_auto%2Cw_1108/v1577039330/p/photo/image/3299736/c72/fotos-de-casas-prefabricadas-de-estilo-moderno-de-prefabricados-palermo.jpg', alt: 'Casa prefabricada colombiana de una planta con fachada clara y jardín sencillo', kicker: 'CASAS PREFABRICADAS · COLOMBIA', title: 'Tu casa.<br><em>Tu forma de vivir.</em>', text: 'Viviendas funcionales que se ven bien, se sienten tuyas y parten de lo que necesitas para tu terreno.', note: 'FACHADA · LUZ · ESPACIO' },
      { image: 'https://imagenes2.eltiempo.com/files/og_thumbnail/uploads/2020/08/29/5f4b288cd7fd2.jpeg', alt: 'Casa prefabricada amarilla de un piso con cubierta roja', kicker: 'SENCILLA, CUIDADA Y FUNCIONAL', title: 'Lo esencial,<br><em>con más carácter.</em>', text: 'Una buena combinación de color, una entrada agradable y detalles bien presentados hacen la diferencia.', note: 'COLOR · CUBIERTA · ENTRADA' },
      { image: 'https://www.minvivienda.gov.co/sites/default/files/noticias/270921_img1.jpg', alt: 'Vivienda prefabricada de paneles verdes y cubierta metálica', kicker: 'IDEAS PARA TU PROYECTO', title: 'Un espacio propio.<br><em>Muchas posibilidades.</em>', text: 'Miremos opciones sin perder de vista el terreno, el presupuesto y lo que incluye cada propuesta.', note: 'PANELES · TERRENO · PROYECTO' }
    ];
    const models = [
      { id: 'compacta', no: '01', title: 'La compacta', tag: 'SENCILLA Y FUNCIONAL', image: 'https://imagenes2.eltiempo.com/files/og_thumbnail/uploads/2020/08/29/5f4b288cd7fd2.jpeg', alt: 'Casa prefabricada amarilla con cubierta roja y un pequeño corredor', body: 'Una idea para priorizar los espacios esenciales y una distribución práctica.' },
      { id: 'familiar', no: '02', title: 'La familiar', tag: 'ESPACIO PARA COMPARTIR', image: 'https://www.sucasaprefabricada.com/wp-content/uploads/2016/01/88m.jpg', alt: 'Casa prefabricada blanca con cubierta roja y corredor al frente', body: 'Una referencia para pensar en áreas comunes y espacios privados según tu familia.' },
      { id: 'corredor', no: '03', title: 'Con corredor', tag: 'UNA ENTRADA ACOGEDORA', image: 'https://www.minvivienda.gov.co/sites/default/files/noticias/270921_img1.jpg', alt: 'Casa prefabricada de paneles verdes con ventanas blancas y cubierta metálica', body: 'Un espacio de entrada cubierto puede ser útil; confirma con el proveedor si está incluido.' }
    ];
    let activeSlide = 0;
    const heroPhoto = document.querySelector('#heroPhoto');
    const heroCopy = document.querySelector('.hero-copy');
    function showSlide(index) {
      activeSlide = (index + slides.length) % slides.length;
      const slide = slides[activeSlide];
      heroPhoto.classList.add('changing');
      heroCopy.classList.add('copy-changing');
      window.setTimeout(() => {
        heroPhoto.src = slide.image;
        heroPhoto.alt = slide.alt;
        document.querySelector('#heroKicker').textContent = slide.kicker;
        document.querySelector('#heroTitle').innerHTML = slide.title;
        document.querySelector('#heroText').textContent = slide.text;
        document.querySelector('#heroNote').textContent = slide.note;
        document.querySelectorAll('.slide-dot').forEach((button, i) => {
          const selected = i === activeSlide;
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        heroPhoto.classList.remove('changing');
        heroCopy.classList.remove('copy-changing');
      }, 240);
    }
    document.querySelectorAll('.slide-dot').forEach(button => button.addEventListener('click', () => showSlide(Number(button.dataset.slide))));
    document.querySelector('#previousSlide').addEventListener('click', () => showSlide(activeSlide - 1));
    document.querySelector('#nextSlide').addEventListener('click', () => showSlide(activeSlide + 1));

    function showModel(id) {
      const model = models.find(item => item.id === id) || models[0];
      document.querySelectorAll('.model-tab').forEach(button => {
        const selected = button.dataset.model === model.id;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-selected', String(selected));
      });
      document.querySelectorAll('.model-image').forEach(img => img.classList.toggle('visible', img.dataset.imageModel === model.id));
      document.querySelector('#modelCounter').textContent = model.no;
      document.querySelector('#detailTag').textContent = model.tag;
      document.querySelector('#detailTitle').textContent = model.title;
      document.querySelector('#detailBody').textContent = model.body;
      document.querySelector('#dialogPhoto').src = model.image;
      document.querySelector('#dialogPhoto').alt = model.alt;
      document.querySelector('#dialogCaption').textContent = model.title + ' · Foto de referencia';
      const typeByModel = {
        compacta: 'Una casa compacta',
        familiar: 'Una casa para mi familia',
        corredor: 'Una casa con corredor'
      };
      const matchingChoice = document.querySelector(
        '.config-group[data-choice-group="vivienda"] .choice-chip[data-value="' + typeByModel[model.id] + '"]'
      );
      if (matchingChoice && !matchingChoice.classList.contains('selected')) matchingChoice.click();
    }
    document.querySelectorAll('.model-tab').forEach(button => button.addEventListener('click', () => showModel(button.dataset.model)));
    document.querySelector('#openModelImage').addEventListener('click', () => document.querySelector('#photoDialog').showModal());
    document.querySelector('#closePhotoDialog').addEventListener('click', () => document.querySelector('#photoDialog').close());
    document.querySelector('#photoDialog').addEventListener('click', event => { if (event.target === event.currentTarget) event.currentTarget.close(); });

    const whatsappNumber = '573134843085'; // Confirmar este número antes del lanzamiento.
    const selections = { vivienda: 'Una casa compacta', terreno: 'Lote destapado o de tierra', prioridad: 'Distribución funcional' };
    function updateSummary() {
      for (const group of Object.keys(selections)) {
        document.querySelector('#summary' + group[0].toUpperCase() + group.slice(1)).textContent = selections[group];
      }
      const message = 'Hola, vi la página de Casas Prefabricadas Vergara y quiero consultar por una casa. Mi idea: ' +
        selections.vivienda + '; mi terreno: ' + selections.terreno + '; prioridad: ' + selections.prioridad +
        '. ¿Me pueden contar qué opciones tienen y qué incluye la propuesta?';
      const link = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(message);
      document.querySelector('#whatsAppFinal').href = link;
    }
    document.querySelectorAll('.config-group').forEach(group => {
      group.querySelectorAll('.choice-chip').forEach(button => button.addEventListener('click', () => {
        group.querySelectorAll('.choice-chip').forEach(option => {
          option.classList.remove('selected');
          option.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('selected');
        button.setAttribute('aria-pressed', 'true');
        selections[group.dataset.choiceGroup] = button.dataset.value;
        updateSummary();
      }));
    });
    document.querySelectorAll('.choice-chip').forEach(button => button.setAttribute('aria-pressed', button.classList.contains('selected') ? 'true' : 'false'));
    updateSummary();

    const menuToggle = document.querySelector('#menuToggle');
    const menuPanel = document.querySelector('#menuPanel');
    menuToggle.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!open));
      menuPanel.hidden = open;
    });
    menuPanel.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      menuPanel.hidden = true;
      menuToggle.setAttribute('aria-expanded', 'false');
    }));
    const progress = document.querySelector('#scrollProgress');
    const topbar = document.querySelector('.topbar');
    const heroSection = document.querySelector('.hero');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // En móvil, deslizar la portada también cambia la foto.
    let swipeStartX = null;
    heroSection.addEventListener('touchstart', event => {
      swipeStartX = event.touches.length === 1 ? event.touches[0].clientX : null;
    }, { passive: true });
    heroSection.addEventListener('touchend', event => {
      if (swipeStartX === null || !event.changedTouches.length) return;
      const distance = event.changedTouches[0].clientX - swipeStartX;
      if (Math.abs(distance) > 55) showSlide(activeSlide + (distance < 0 ? 1 : -1));
      swipeStartX = null;
    }, { passive: true });

    function updateScrollUI() {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.width = (max > 0 ? window.scrollY / max * 100 : 0) + '%';
      topbar.classList.toggle('is-scrolled', window.scrollY > 24);
    }
    window.addEventListener('scroll', updateScrollUI, { passive: true });
    updateScrollUI();

    const revealItems = document.querySelectorAll(
      '.section-heading, .model-list, .model-visual, .models-footer, .config-heading, .config-steps, .config-summary, .contact-copy, .contact-panel'
    );
    if ('IntersectionObserver' in window && !reducedMotion) {
      document.body.classList.add('motion-enabled');
      const revealObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          // El reveal se activa al entrar en pantalla y se revierte al salir,
          // tanto al bajar como al volver a subir por la página.
          entry.target.classList.toggle('is-visible', entry.isIntersecting);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -4% 0px' });
      revealItems.forEach(item => {
        item.classList.add('reveal');
        revealObserver.observe(item);
      });
    }

    if (!reducedMotion && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
      heroSection.addEventListener('pointermove', event => {
        const bounds = heroSection.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        heroPhoto.style.setProperty('--pointer-x', (x * -9).toFixed(2) + 'px');
        heroPhoto.style.setProperty('--pointer-y', (y * -6).toFixed(2) + 'px');
      });
      heroSection.addEventListener('pointerleave', () => {
        heroPhoto.style.setProperty('--pointer-x', '0px');
        heroPhoto.style.setProperty('--pointer-y', '0px');
      });
    }
  </script>
</body>
</html>